{
  "name": "render-dispatch-stack",
  "version": "0.1.0",
  "description": "CDK stack: S3 upload -> Lambda -> DynamoDB event layer, plus a static S3 + CloudFront web app that displays uploaded file names",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never",
    "destroy": "cdk destroy"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "aws-cdk": "^2.1106.1",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.278.0"
  }
}
